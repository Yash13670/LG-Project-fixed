# Put your NEW key here locally. Never upload or commit this file.
OPENROUTER_API_KEY=replace_with_your_new_key
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Keep dispatch in simulation mode. No real email is sent.
EMAIL_MODE=simulation
DATABASE_PATH=data/refund_cases.db
CHECKPOINT_DATABASE_PATH=data/refund_checkpoints.sqlite
MAX_UPLOAD_SIZE_MB=10
